[Unit]
Description=sorus (Staging)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/sorus
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=20s
StateDirectory=sorus-staging
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sorus-staging
Environment=DB_PATH=/var/lib/sorus-staging/database.db
Environment=UPLOAD_DIR=/var/lib/sorus-staging/uploads
Environment=SEARCH_INDEX_DIR=/var/lib/sorus-staging/search_index
Environment=ATTACHMENT_DIR=/var/lib/sorus-staging/attachments
Environment=BACKUP_DIR=/var/lib/sorus-staging/backups
Environment=PORT=8081
EnvironmentFile=-/etc/sorus/sorus-staging.env
User=sorus-staging
Group=sorus-staging
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
LimitNOFILE=65536
MemoryMax=1G
TasksMax=512

[Install]
WantedBy=multi-user.target
