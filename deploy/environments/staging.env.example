# ステージング用。本番とは必ず別のデータ領域・認証情報を使ってください。
PORT=8081
DB_PATH=/var/lib/sorus-staging/database.db
UPLOAD_DIR=/var/lib/sorus-staging/uploads
SEARCH_INDEX_DIR=/var/lib/sorus-staging/search_index
ATTACHMENT_DIR=/var/lib/sorus-staging/attachments
BACKUP_DIR=/var/lib/sorus-staging/backups
SITE_NAME=【検証】sorus
BASE_URL=http://<host>:8081
SECURE_COOKIE=false
# ADMIN_PASSWORD と外部 API キーは運用者が安全に設定してください。
