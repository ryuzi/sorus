# 本番用。実際の値を設定した production.env を作成し、アクセス権を制限してください。
PORT=8080
DB_PATH=/data/database.db
UPLOAD_DIR=/data/uploads
SEARCH_INDEX_DIR=/data/search_index
ATTACHMENT_DIR=/data/attachments
BACKUP_DIR=/data/backups
AUTOCERT_DOMAIN=example.ac.jp
AUTOCERT_EMAIL=ops@example.ac.jp
AUTOCERT_CACHE_DIR=/data/certs
SITE_NAME=sorus
BASE_URL=https://example.jp
SECURE_COOKIE=true
# ADMIN_PASSWORD は必ず強固で一意な値を設定してください。
